# Nuru local development configuration — PLACEHOLDERS ONLY, never real secrets.
# Copy to .env (git-ignored) or export these variables in your shell.

# SQL Server connection (used by backend/src/main/resources/application.yml)
MSSQL_HOST=localhost
MSSQL_PORT=7862
MSSQL_DB=nuru
MSSQL_USER=sa
MSSQL_PASSWORD=change-me-in-your-shell
# Trust the server certificate for LOCAL development only (self-signed Docker cert).
MSSQL_TRUST_CERT=true

# Auth: base64 or plain secret >= 32 chars for local JWT signing. Generate a strong one per environment.
NURU_JWT_SECRET=change-me-to-a-long-random-local-dev-secret-32-chars-min
NURU_JWT_ACCESS_MINUTES=30
NURU_REFRESH_TOKEN_DAYS=14

# AI provider: blank = UNCONFIGURED (assistant reports unavailable).
# Use DEV for the deterministic local adapter (no model calls, recorded data only),
# or OPENAI_COMPATIBLE with base URL + key + model for a live model.
NURU_AI_PROVIDER=
NURU_AI_BASE_URL=
NURU_AI_API_KEY=
NURU_AI_MODEL=
NURU_AI_TIMEOUT_MS=15000
NURU_AI_MAX_TOOL_STEPS=4
NURU_AI_RETENTION_DAYS=90
NURU_AI_PROPOSAL_EXPIRY_HOURS=24

# Notifications: leave blank to use logging dev adapters (nothing is actually sent).
NURU_EMAIL_PROVIDER=
NURU_SMS_PROVIDER=

# Identity verification / credit: leave blank = UNCONFIGURED (statuses report unavailable).
NURU_IDV_PROVIDER=
NURU_CREDIT_PROVIDER=

# Payments: MANUAL (record-keeping only) or SANDBOX adapter. Nothing here moves real funds.
NURU_PAYMENT_MODE=MANUAL
